@model SporBeslenmeWeb.Models.KullaniciDetay

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4" style="background: #1e2229; border: 1px solid #334155 !important;">
                <div class="card-body p-5">

                    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary pb-3">
                        <h3 class="text-info fw-bold mb-0">Profil Bilgilerim</h3>
                        <a asp-action="ProfilGuncelle" class="btn btn-outline-info btn-sm rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-pencil me-1"></i> Düzenle
                        </a>
                    </div>

                    <div class="row text-center g-3 mb-5">
                        <div class="col-4">
                            <div class="p-3 rounded-4 bg-dark border border-secondary shadow-sm">
                                <h4 class="text-info fw-bold mb-0">@Model.Boy</h4>
                                <small class="text-secondary text-uppercase">Boy (cm)</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-4 bg-dark border border-secondary shadow-sm">
                                <h4 class="text-info fw-bold mb-0">@Model.Kilo</h4>
                                <small class="text-secondary text-uppercase">Kilo (kg)</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-4 bg-dark border border-secondary shadow-sm">
                                <h4 class="text-info fw-bold mb-0">@Model.Yas</h4>
                                <small class="text-secondary text-uppercase">Yaş</small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6 text-center text-md-start">
                            <label class="text-secondary small mb-2 d-block fw-bold">GÜNCEL HEDEF</label>
                            <div class="d-inline-block px-4 py-2 rounded-3 fw-bold text-dark bg-info shadow-sm w-100 text-center">
                                @(Model.Hedef == "KiloVerme" ? "🔥 Kilo Verme" : Model.Hedef == "KasKazanimi" ? "💪 Kas Kazanımı" : "⚡ Kondisyon")
                            </div>
                        </div>
                        <div class="col-md-6 text-center text-md-start">
                            <label class="text-secondary small mb-2 d-block fw-bold">ANTRENMAN DÜZENİ</label>
                            <div class="d-inline-block px-4 py-2 rounded-3 fw-bold border border-info text-info shadow-sm w-100 text-center" style="background: rgba(13, 202, 240, 0.1);">
                                @(Model.AntrenmanSeviyesi == "Baslangic" ? "🥉 Haftada 3 Gün" : Model.AntrenmanSeviyesi == "Orta" ? "🥈 Haftada 4 Gün" : Model.AntrenmanSeviyesi == "Ileri" ? "🥇 Haftada 5 Gün" : "Belirtilmemiş")
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="text-secondary small mb-2 d-block fw-bold">VÜCUT ÖLÇÜLERİ</label>
                            <div class="p-3 rounded-3 bg-dark border border-secondary text-light small d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between"><span class="text-info">Omuz</span> <span class="fw-bold">@(Model.Omuz?.ToString() ?? "-") cm</span></div>
                                <div class="d-flex justify-content-between"><span class="text-info">Göğüs</span> <span class="fw-bold">@(Model.Gogus?.ToString() ?? "-") cm</span></div>
                                <div class="d-flex justify-content-between"><span class="text-info">Bel</span> <span class="fw-bold">@(Model.Bel?.ToString() ?? "-") cm</span></div>
                                <div class="d-flex justify-content-between"><span class="text-info">Kol</span> <span class="fw-bold">@(Model.Kol?.ToString() ?? "-") cm</span></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-warning small mb-2 d-block fw-bold">SAĞLIK DURUMU</label>
                            <div class="p-3 rounded-3 bg-dark border border-warning-subtle text-warning small h-100 d-flex align-items-center">
                                @(string.IsNullOrEmpty(Model.Hastaliklar) ? "Kayıtlı bir fiziksel/kronik engel bulunmuyor." : Model.Hastaliklar)
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label class="text-warning small mb-2 d-block fw-bold">BESLENME ALIŞKANLIKLARI</label>
                            <div class="p-3 rounded-3 bg-dark border border-warning-subtle text-light small">
                                <div class="mb-3 border-bottom border-secondary pb-2">
                                    <span class="text-warning fw-bold d-block mb-1"><i class="bi bi-shield-exclamation me-1"></i> Alerji & Diyet Tipi:</span>
                                    <span class="text-light">@(string.IsNullOrEmpty(Model.BeslenmeKisitlamalari) ? "Kayıtlı bir alerji veya kısıtlama yok." : Model.BeslenmeKisitlamalari)</span>
                                </div>
                                <div>
                                    <span class="text-warning fw-bold d-block mb-1"><i class="bi bi-x-circle me-1"></i> Sevilmeyen Besinler:</span>
                                    <span class="text-secondary">@(string.IsNullOrEmpty(Model.SevmedigiBesinler) ? "Belirtilmemiş." : Model.SevmedigiBesinler)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>