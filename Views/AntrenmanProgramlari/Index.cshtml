@using SporBeslenmeWeb.Models
@model IEnumerable<AntrenmanProgrami>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-info pb-3">
        <div>
            <h2 class="text-info fw-bold mb-0">Antrenman Programları</h2>
            <p class="text-light mt-2 mb-0">Seviyene uygun planı seç ve hemen çalışmaya başla.</p>
        </div>
        <div>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
            <a asp-action="Ekle" class="btn btn-info fw-bold text-dark fs-5">
                + Yeni Program Ekle
            </a>
}
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert text-center py-5" style="background: #1e2229; border: 1px dashed #0dcaf0;">
            <h4 class="text-secondary mb-3">Henüz sistemde bir antrenman programı bulunmuyor.</h4>
            <p class="text-light">Hemen sağ üstteki "Yeni Program Ekle" butonuna tıklayarak ilk programı ve videoları yüklemeye başlayabilirsin.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100" style="background: #1e2229; border: 1px solid #0dcaf0; box-shadow: 0 0 15px rgba(13, 202, 240, 0.2);">
                        <div class="card-body text-light">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-info text-dark mb-2">@item.Seviye</span>
                                <span class="text-secondary">@item.GunSayisi Gün</span>
                            </div>
                            <h4 class="card-title text-info fw-bold">@item.Baslik</h4>
                            <p class="card-text text-secondary">@item.Aciklama</p>
                        </div>
                        <div class="card-footer border-0 bg-transparent pb-4 d-flex gap-2">
                            <a asp-action="Detay" asp-route-id="@item.Id" class="btn btn-info flex-grow-1 fw-bold text-dark">Başla</a>
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-warning fw-bold text-dark">Düzenle</a>

                                <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-danger fw-bold" onclick="return confirm('Bu programı ve içindeki tüm videoları silmek istediğinize emin misiniz?');">Sil</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>