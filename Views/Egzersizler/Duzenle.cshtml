@model SporBeslenmeWeb.Models.Egzersizler

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg mt-4">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h4 class="mb-0 fw-bold">Egzersizi Düzenle</h4>
                </div>
                <div class="card-body p-5 bg-light">

                    <form asp-action="Duzenle" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="EgzersizID" />
                        <input type="hidden" asp-for="VideoYolu" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Egzersiz Adı</label>
                            <input asp-for="Ad" class="form-control form-control-lg shadow-sm" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Hangi Kas Grubu?</label>
                            <select asp-for="KasGrupID" class="form-select form-select-lg shadow-sm" asp-items="ViewBag.KasGruplari" required>
                                <option value="">Lütfen seçin</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Zorluk Seviyesi</label>
                            <input asp-for="ZorlukSeviyesi" class="form-control form-control-lg shadow-sm" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Nasıl Yapılır?</label>
                            <textarea asp-for="NasilYapilir" class="form-control shadow-sm" rows="4"></textarea>
                        </div>

                        <div class="p-4 mb-4 rounded-3 border border-secondary bg-white shadow-sm">
                            <h6 class="text-info fw-bold mb-3"><i class="bi bi-cpu"></i> Algoritma Kriterleri</h6>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark">Hedef Kitle</label>
                                <select asp-for="HedefKitle" class="form-select border-info">
                                    <option value="Genel">Herkes İçin (Genel)</option>
                                    <option value="KasKazanimi">Kas Kazanımı / Hacim</option>
                                    <option value="KiloVerme">Kilo Verme / Yağ Yakımı</option>
                                    <option value="Kondisyon">Kondisyon / Güç</option>
                                </select>
                            </div>

                            <div>
                                <label class="form-label fw-bold text-dark">Riskli Durumlar</label>
                                <input asp-for="RiskliDurumlar" class="form-control border-danger" placeholder="Örn: Bel Fıtığı" />
                            </div>
                        </div>

                        <div class="mb-5 p-3 bg-white border border-secondary rounded shadow-sm">
                            <label class="form-label fw-bold text-secondary">Yeni Video Yükle (Değiştirmek İstersen)</label>
                            <input type="file" name="YeniVideoDosyasi" class="form-control form-control-lg" accept="video/mp4" />
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm">Değişiklikleri Kaydet</button>
                            <a href="/Egzersizler/Index" class="btn btn-outline-dark btn-lg fw-bold">Listeye Geri Dön</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>