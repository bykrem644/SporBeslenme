@model SporBeslenmeWeb.Models.Egzersizler

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg mt-4">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h4 class="mb-0 fw-bold">Yeni Egzersiz Ekle</h4>
                </div>
                <div class="card-body p-5 bg-light">

                    <form method="post" action="/Egzersizler/Ekle" enctype="multipart/form-data">

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Egzersiz Adı</label>
                            <input type="text" name="Ad" class="form-control form-control-lg shadow-sm" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Hangi Kas Grubu</label>
                            <select name="KasGrupID" class="form-select form-select-lg shadow-sm" asp-items="ViewBag.KasGruplari" required>
                                <option value="">Lütfen bir kas grubu seçin</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Zorluk Seviyesi</label>
                            <input type="text" name="ZorlukSeviyesi" class="form-control form-control-lg shadow-sm" placeholder="Örn: Başlangıç, Orta, İleri" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Nasıl Yapılır</label>
                            <textarea name="NasilYapilir" class="form-control shadow-sm" rows="4"></textarea>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold text-secondary">Egzersiz Videosu Yükle</label>
                            <input type="file" name="VideoDosyasi" class="form-control form-control-lg shadow-sm" accept="video/mp4" />
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">Kaydet</button>
                            <a href="/Egzersizler/Index" class="btn btn-outline-dark btn-lg fw-bold">Listeye Geri Dön</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>