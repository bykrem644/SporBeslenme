@model IEnumerable<SporBeslenmeWeb.Models.Egzersizler>

<div class="container mt-4">
    <h2 class="text-light mb-4 fw-bold">Egzersiz Listesi</h2>

    <div class="row mb-4 justify-content-end">
        <div class="col-md-4">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-dark border-info text-info">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="canliAramaKutusu" class="form-control bg-dark text-light border-info" placeholder="Ne arıyorsunuz? (İsim, kelime...)">
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <a href="/Egzersizler/Ekle" class="btn btn-outline-info rounded-pill fw-bold mb-4 px-4">
            <i class="bi bi-plus-lg"></i> Yeni Egzersiz Ekle
        </a>
    }

    <div class="row">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4 arama-elemani">
                    <div class="card h-100 shadow-lg bg-dark border-secondary rounded-4 overflow-hidden hover-card transition-all">

                        @if (!string.IsNullOrEmpty(item.VideoYolu))
                        {
                            <video class="card-img-top border-bottom border-secondary" controls preload="metadata" style="max-height: 250px; background-color: #000; object-fit: cover;">
                                <source src="@item.VideoYolu" type="video/mp4">
                                Tarayıcınız video etiketini desteklemiyor.
                            </video>
                        }
                        else
                        {
                            <div class="bg-dark text-center py-5 border-bottom border-secondary d-flex flex-column justify-content-center align-items-center" style="height: 250px;">
                                <i class="bi bi-camera-video-off fs-1 text-secondary mb-2"></i>
                                <span class="text-secondary">Video Yüklenmedi</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title text-info fw-bold mb-2">@item.Ad</h5>
                            <h6 class="card-subtitle mb-3 text-warning"><i class="bi bi-bar-chart-fill"></i> Zorluk Seviyesi: @item.ZorlukSeviyesi</h6>

                            <p class="card-text text-light" style="font-size: 0.9rem; opacity: 0.85; line-height: 1.6;">
                                @item.NasilYapilir
                            </p>

                            <div class="mt-auto">
                                <hr class="border-secondary my-3" />
                                <div class="d-flex justify-content-between">
                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                    {
                                        <a href="/Egzersizler/Duzenle/@item.EgzersizID" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">Düzenle</a>
                                        <a href="/Egzersizler/Sil/@item.EgzersizID" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" onclick="return confirm('Bu egzersizi silmek istediğinize emin misiniz?');">Sil</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const aramaKutusu = document.getElementById("canliAramaKutusu");
            const elemanlar = document.querySelectorAll(".arama-elemani");

            if (aramaKutusu) {
                aramaKutusu.addEventListener("input", function (e) {
                    const arananKelime = e.target.value.toLowerCase();

                    elemanlar.forEach(function (eleman) {
                        // Kartın içindeki her şeyi (Başlık, açıklama, zorluk) metin olarak alıyoruz
                        const kartMetni = eleman.innerText.toLowerCase();

                        // Aranan harfler kartın içinde varsa göster, yoksa gizle
                        if (kartMetni.includes(arananKelime)) {
                            eleman.classList.remove("d-none");
                        } else {
                            eleman.classList.add("d-none");
                        }
                    });
                });
            }
        });
    </script>
}