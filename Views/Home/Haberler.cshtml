@{
    ViewData["Title"] = "Spor Haberleri";
}

<div class="container mt-5">
    <h2 class="text-info fw-bold mb-4">📢 Güncel Spor Haberleri</h2>

    @if (ViewBag.HataMesaji != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger p-4 rounded-3 mb-4">
            <h5 class="fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Sistem Bağlantı Hatası</h5>
            <p class="mb-0">Hata Detayı: @ViewBag.HataMesaji</p>
            <small class="text-muted">Projenin dış servise erişirken aldığı teknik hata yukarıdadır.</small>
        </div>
    }

    <div class="row">
        @if (ViewBag.Haberler != null && ((List<SporBeslenmeWeb.Models.SporHaberi>)ViewBag.Haberler).Count > 0)
        {
            foreach (var haber in (List<SporBeslenmeWeb.Models.SporHaberi>)ViewBag.Haberler)
            {
                <div class="col-md-6 mb-4">
                    <div class="card bg-dark border-secondary h-100 p-3 shadow-lg rounded-4 hover-card transition-all">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-danger align-self-start mb-2 px-3 py-1 fw-bold">@haber.Kaynak</span>
                            <h5 class="card-title text-white fw-bold mb-3">@haber.Baslik</h5>ss
                            <p class="card-text text-light small mb-4" style="opacity: 0.85; line-height: 1.6;">
                                @haber.Aciklama
                            </p>
                            <a href="@haber.Url" target="_blank" class="btn btn-outline-info rounded-pill fw-bold mt-auto w-100">
                                Detayı Oku <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else if (ViewBag.HataMesaji == null)
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-newspaper fs-1 mb-2"></i>
                <p>Şu an gösterilecek güncel haber bulunamadı.</p>
            </div>
        }
    </div>
</div>