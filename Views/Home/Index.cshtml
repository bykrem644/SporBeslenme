</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const kaslar = document.querySelectorAll('.kas-bolgesi');
        const sonucAlani = document.getElementById('sonucAlani');

        kaslar.forEach(kas => {
            kas.addEventListener('click', function () {
                const kasId = this.getAttribute('data-id');

                // Tıklanan kas grubunun kırmızı yanık kalmasını sağla
                document.querySelectorAll('.kas-bolgesi').forEach(k => k.classList.remove('active'));

                // Sağ ve sol kollara/bacaklara aynı anda tıklanmış gibi ikisini de kırmızı yap
                document.querySelectorAll(`.kas-bolgesi[data-id="${kasId}"]`).forEach(k => k.classList.add('active'));

                sonucAlani.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary" role="status"></div></div>';

                fetch('/Home/KasEgzersizleriniGetir/' + kasId)
                    .then(response => response.json())
                    .then(data => {
                        sonucAlani.innerHTML = '';

                        if (data.length === 0) {
                            sonucAlani.innerHTML = '<div class="alert alert-info">Bu kas grubu için henüz bir video eklenmemiş.</div>';
                            return;
                        }

                        data.forEach(item => {
                            let videoHtml = item.videoYolu
                                ? `<video class="w-100 rounded" controls><source src="${item.videoYolu}" type="video/mp4"></video>`
                                : `<div class="p-5 bg-light text-center text-muted">Video mevcut değil</div>`;

                            let card = `
                                <div class="col-md-12 mb-4">
                                    <div class="card shadow-sm border-0 bg-light">
                                        ${videoHtml}
                                        <div class="card-body">
                                            <h5 class="card-title text-danger fw-bold">${item.ad}</h5>
                                            <span class="badge bg-secondary mb-2">${item.zorlukSeviyesi || ''}</span>
                                            <p class="card-text small">${item.nasilYapilir || ''}</p>
                                        </div>
                                    </div>
                                </div>`;
                            sonucAlani.innerHTML += card;
                        });
                    })
                    .catch(err => {
                        sonucAlani.innerHTML = '<div class="alert alert-danger">Veriler yüklenirken bir hata oluştu.</div>';
                    });
            });
        });
    });
</script>