        <!-- SAĞ TARAF: VİDEO SONUÇLARI (Sağ kolon) -->
        <div class="col-md-7 border-start">
            <h4 class="text-center text-primary fw-bold mb-4">Egzersiz Rehberi</h4>
            <div id="sonucAlani" class="row">
                <div class="col-12 text-center mt-5">
                    <h5 class="text-muted">Lütfen sol taraftan bir kas grubu seçin.</h5>
                </div>
            </div>
        </div>

