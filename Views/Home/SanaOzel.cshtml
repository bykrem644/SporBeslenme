@using System.Collections.Generic
@model SporBeslenmeWeb.Models.OnerilerViewModel

@{
    ViewData["Title"] = "Sana Özel Program";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0 rounded-4 mb-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border: 1px solid #334155 !important;">
        <div class="card-body p-4 text-center text-md-start">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="text-info fw-bold mb-1">✨ Sana Özel Analiz Raporu</h2>
                    <p class="text-secondary mb-0">Profilindeki verilere, hedefine ve sağlık durumuna göre filtrelendi.</p>
                </div>
                <div class="col-md-4 text-center mt-3 mt-md-0">
                    <div class="d-inline-block p-3 rounded-4 border border-info" style="background: rgba(13, 202, 240, 0.1);">
                        <div class="small text-secondary text-uppercase fw-bold">Vücut Kitle İndeksin</div>
                        <h2 class="text-info fw-bold mb-0">@Model.VKI</h2>
                        <span class="badge @(Model.Durum == "Normal" ? "bg-success" : "bg-warning") text-dark rounded-pill px-3">@Model.Durum</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-light fw-bold border-start border-info border-4 ps-3">Haftalık Antrenman Programın</h3>
        <span class="badge bg-dark border border-info text-info rounded-pill px-3 py-2 small">
            <i class="bi bi-shield-check"></i> Sağlık Onaylı
        </span>
    </div>

    @if (Model.GunlukProgram != null && Model.GunlukProgram.Any())
    {
        @foreach (var gun in Model.GunlukProgram)
        {
            <h5 class="text-info mt-4 mb-3 border-bottom border-secondary pb-2"><i class="bi bi-calendar-event"></i> @gun.Key</h5>

            <div class="row g-4 mb-4">
                @if (gun.Value.Any())
                {
                    @foreach (var item in gun.Value)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 bg-dark border-secondary hover-card transition-all shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; min-width: 45px;">
                                            <i class="bi bi-lightning-fill text-dark fs-5"></i>
                                        </div>
                                        <h5 class="card-title text-info fw-bold mb-0">@item.Ad</h5>
                                    </div>
                                    <p class="card-text text-secondary small">
                                        @(item.NasilYapilir?.Length > 100 ? item.NasilYapilir.Substring(0, 100) + "..." : item.NasilYapilir)
                                    </p>
                                </div>
                                <div class="card-footer border-0 bg-transparent pb-3 pt-0">
                                    <a asp-controller="Egzersizler" asp-action="Index" class="btn btn-outline-info rounded-pill w-100 fw-bold text-center">
                                        Egzersizlere Git
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12"><p class="text-secondary small">Bu güne atanmış hareket bulunamadı. Havuzda daha fazla hareket olmalı.</p></div>
                }
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5 border border-secondary border-dashed rounded-4 mb-5">
            <p class="text-secondary mb-0">Şu an hedefine ve sağlık durumuna uygun bir egzersiz bulunmuyor.</p>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pt-4 mt-2">
        <h3 class="text-warning fw-bold border-start border-warning border-4 ps-3">Önerilen Beslenme Planı</h3>
        <span class="badge bg-dark border border-warning text-warning rounded-pill px-3 py-2 small">Alerjen Filtreli</span>
    </div>

    <div class="row g-4 mb-5">
        @if (Model.Tarifler != null && Model.Tarifler.Any())
        {
            @foreach (var tarif in Model.Tarifler)
            {
                <div class="col-md-6">
                    <div class="card bg-dark border-secondary hover-card shadow-sm">
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="text-warning fw-bold mb-1">@tarif.Ad</h5>
                                    <div class="mb-2">
                                        <span class="badge bg-warning text-dark me-2" style="font-size: 0.7rem;">@tarif.Kategori</span>
                                    </div>
                                </div>
                                <a asp-controller="Tarifler" asp-action="Detay" asp-route-id="@tarif.TarifID" class="btn btn-outline-warning btn-sm rounded-circle px-2">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-4 text-secondary border border-secondary border-dashed rounded-4">
                <p class="mb-0">Alerjilerine ve zevklerine uygun tarif şu an bulunamadı. (Admin paneline tarif ekle!)</p>
            </div>
        }
    </div>

    @if (Model.GununMakalesi != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4 pt-2">
            <h3 class="text-primary fw-bold border-start border-primary border-4 ps-3">Günün Makalesi</h3>
        </div>
        <div class="card shadow-lg border-primary rounded-4 mb-5" style="background: #1e2229;">
            <div class="card-body p-4">
                <h4 class="text-primary fw-bold">@Model.GununMakalesi.Baslik</h4>
                <p class="text-light mt-3">
                    @Html.Raw(Model.GununMakalesi.Icerik?.Length > 200 ? Model.GununMakalesi.Icerik.Substring(0, 200) + "..." : Model.GununMakalesi.Icerik)
                </p>
                <a asp-controller="Makaleler" asp-action="Detay" asp-route-id="@Model.GununMakalesi.Id" class="btn btn-primary text-dark fw-bold rounded-pill px-4 mt-2">Devamını Oku</a>
            </div>
        </div>
    }
</div>

<style>
    .hover-card:hover {
        transform: translateY(-5px);
        border-color: #0dcaf0 !important;
        box-shadow: 0 8px 25px rgba(0,0,0,0.5) !important;
        transition: all 0.3s ease;
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>