@{
    ViewData["Title"] = "VKİ Hesaplayıcı";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card" style="background: #1e2229; border: 1px solid #0dcaf0; box-shadow: 0 0 15px rgba(13, 202, 240, 0.2);">
                <div class="card-header border-info">
                    <h4 class="text-info fw-bold text-center mb-0">Gelişmiş Vücut Analizi</h4>
                </div>
                <div class="card-body text-light">

                    <form asp-action="VkiHesapla" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Cinsiyet</label>
                                <select name="cinsiyet" id="cinsiyetSecim" class="form-select bg-dark text-light border-secondary" onchange="CinsiyetKontrol()" required>
                                    <option value="Erkek">Erkek</option>
                                    <option value="Kadin">Kadın</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Yaşınız</label>
                                <input type="number" name="yas" class="form-control bg-dark text-light border-secondary" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Boy (cm)</label>
                                <input type="number" step="0.1" name="boy" class="form-control bg-dark text-light border-secondary" placeholder="Örn: 180" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Kilo (kg)</label>
                                <input type="number" step="0.1" name="kilo" class="form-control bg-dark text-light border-secondary" placeholder="Örn: 75" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Boyun Çevresi (cm)</label>
                                <input type="number" step="0.1" name="boyun" class="form-control bg-dark text-light border-secondary" placeholder="Adem elmasının altı" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-info">Bel Çevresi (cm)</label>
                                <input type="number" step="0.1" name="bel" class="form-control bg-dark text-light border-secondary" placeholder="Göbek deliği hizası" required>
                            </div>
                            <div class="col-md-6 mb-3 d-none" id="kalcaDiv">
                                <label class="form-label text-info">Kalça Çevresi (cm)</label>
                                <input type="number" step="0.1" name="kalca" id="kalcaInput" class="form-control bg-dark text-light border-secondary" placeholder="En geniş bölge">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-info w-100 fw-bold mt-3 text-dark">Analiz Et</button>
                    </form>

                    @if (ViewBag.Vki != null)
                    {
                        <hr class="border-info mt-4">
                        <div class="text-center mt-4">
                            <h5 class="text-light">Vücut Kitle İndeksiniz: <span class="text-info fs-3 fw-bold">@ViewBag.Vki</span></h5>
                            <h5 class="text-light">Tahmini Yağ Oranınız: <span class="text-warning fs-3 fw-bold">%@ViewBag.YagOrani</span></h5>
                            <h6 class="mt-3 text-secondary">Genel Durum: @ViewBag.Durum</h6>
                        </div>
                    }
                </div>
            </div>

            @if (ViewBag.Gecmis != null)
            {
                var gecmisListesi = ViewBag.Gecmis as IEnumerable<SporBeslenmeWeb.Models.VkiGecmisi>;
                if (gecmisListesi != null && gecmisListesi.Any())
                {
                    <div class="card mt-4 shadow-lg" style="background: #1e2229; border: 1px solid #0dcaf0;">
                        <div class="card-header border-info bg-dark">
                            <h5 class="text-info fw-bold mb-0 text-center"><i class="bi bi-clock-history"></i> VKİ Geçmişin</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-dark table-hover mb-0 text-center align-middle" style="background: transparent;">
                                    <thead>
                                        <tr class="text-secondary small">
                                            <th>Tarih</th>
                                            <th>Boy / Kilo</th>
                                            <th>VKİ</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in gecmisListesi)
                                        {
                                            <tr>
                                                <td class="text-light small">@item.Tarih.ToString("dd MMM yyyy - HH:mm")</td>
                                                <td class="text-secondary small">@item.Boy cm / @item.Kilo kg</td>
                                                <td class="text-info fw-bold">@item.VkiSonucu</td>
                                                <td>
                                                    <span class="badge @(item.Durum == "Normal" ? "bg-success" : (item.Durum == "Zayıf" ? "bg-warning" : "bg-danger")) text-dark">
                                                        @item.Durum
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cinsiyete göre Kalça ölçüsü kutusunu göster/gizle
        function CinsiyetKontrol() {
            var cinsiyet = document.getElementById("cinsiyetSecim").value;
            var kalcaDiv = document.getElementById("kalcaDiv");
            var kalcaInput = document.getElementById("kalcaInput");

            if (cinsiyet === "Kadin") {
                kalcaDiv.classList.remove("d-none");
                kalcaInput.setAttribute("required", "required");
            } else {
                kalcaDiv.classList.add("d-none");
                kalcaInput.removeAttribute("required");
                kalcaInput.value = ""; // Temizle
            }
        }
    </script>
}