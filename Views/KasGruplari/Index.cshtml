@model IEnumerable<SporBeslenmeWeb.Models.KasGruplari>

@{
    ViewData["Title"] = "Kas Grupları";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">Kas Grupları Listesi</h2>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
       <a href="/KasGruplari/Ekle" class="btn btn-danger fw-bold shadow-sm">Yeni Kas Grubu Ekle</a>
}
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-12 mb-3">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title text-white fw-bold mb-1">@item.Ad</h5>
                            <p class="card-text text-muted small mb-0">@item.Aciklama</p>
                        </div>
                        <div>
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <a href="/KasGruplari/Duzenle/@item.KasGrupID" class="btn btn-outline-light btn-sm fw-bold me-2">Düzenle</a>
                                <a href="/KasGruplari/Sil/@item.KasGrupID" class="btn btn-outline-danger btn-sm fw-bold">Sil</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>