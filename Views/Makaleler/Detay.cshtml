@using SporBeslenmeWeb.Models
@model Makale

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <span class="badge bg-info text-dark mb-3 px-3 py-2 fs-6 rounded-pill">Uzman Makalesi</span>
                <h1 class="text-light fw-bold mb-3">@Model.Baslik</h1>
                <div class="text-secondary d-flex justify-content-center gap-4">
                    <span><strong class="text-info">✍️ Yazar:</strong> @Model.Yazar</span>
                    <span><strong class="text-info">📅 Tarih:</strong> @Model.YayinTarihi.ToString("dd MMMM yyyy")</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.KapakGorseliUrl))
            {
                <div class="text-center mb-5">
                    <img src="@Model.KapakGorseliUrl" class="img-fluid rounded-4 shadow" alt="@Model.Baslik" style="max-height: 350px; width: 100%; object-fit: cover; border: 1px solid rgba(13, 202, 240, 0.3);">
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.PdfDosyaUrl))
            {
                <div class="d-flex justify-content-between align-items-center p-4 mb-5 rounded-4 shadow-sm" style="background: linear-gradient(145deg, #1e2229, #15181d); border-left: 5px solid #ffc107;">
                    <div>
                        <h5 class="text-warning fw-bold mb-1">Ekli PDF Dökümanı</h5>
                        <p class="text-secondary mb-0 small">Bu makale için hazırlanmış detaylı rehberi inceleyebilirsiniz.</p>
                    </div>
                    <div>
                        <a href="@Model.PdfDosyaUrl" target="_blank" class="btn btn-warning fw-bold text-dark px-4 rounded-pill">
                            PDF'i Görüntüle / İndir
                        </a>
                    </div>
                </div>
            }

            <div class="makale-icerik text-light fs-5 p-4 rounded-4 shadow-sm" style="background: #1e2229; line-height: 1.9; border: 1px solid rgba(255,255,255,0.05);">
                @Html.Raw(Model.Icerik)
            </div>

            <div class="mt-5 text-center">
                <a asp-action="Index" class="btn btn-outline-info rounded-pill px-5 py-2 fw-bold">🔙 Tüm Makalelere Dön</a>
            </div>

        </div>
    </div>
</div>