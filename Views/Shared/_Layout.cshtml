@using Microsoft.AspNetCore.Identity
@using SporBeslenmeWeb.Data
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spor Beslenme</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Standart Karanlık Mod Stilleri */
        body {
            background-color: #121418 !important;
            color: #e0e0e0 !important;
            transition: all 0.3s ease;
            zoom: 0.9; /* Tüm siteyi %90 oranında küçültür */
            -moz-transform: scale(0.9); /* Firefox uyumluluğu için */
            -moz-transform-origin: top center;
        }

        header .navbar {
            background-color: #1e2229 !important;
            border-bottom: 2px solid #ff4757 !important;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.2) !important;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            color: #ff4757 !important;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(255, 71, 87, 0.3);
        }

        .nav-link {
            color: #ffffff !important;
        }

            .nav-link:hover {
                color: #ff4757 !important;
            }

        .card {
            background-color: #1e2229 !important;
            border: 1px solid #2c313a !important;
            transition: all 0.3s ease;
        }

        .card-header {
            background-color: #121418 !important;
            border-bottom: 1px solid #ff4757 !important;
        }

        .form-control, .form-select {
            background-color: #2a2f38 !important;
            border: 1px solid #404654 !important;
            color: #ffffff !important;
        }

        h1, h2, h3, h4, h5, h6, label, th, td {
            color: #ffffff !important;
        }

        /* Aydınlık Mod (Light Mode) */
        body.light-mode {
            background-color: #f8f9fa !important;
            color: #212529 !important;
        }

            body.light-mode header .navbar {
                background-color: #ffffff !important;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
            }

            body.light-mode .nav-link {
                color: #212529 !important;
            }

            body.light-mode .card {
                background-color: #ffffff !important;
                border: 1px solid #dee2e6 !important;
            }

            body.light-mode .card-header {
                background-color: #f8f9fa !important;
            }

            body.light-mode h1, body.light-mode h2, body.light-mode h3, body.light-mode h4, body.light-mode h5, body.light-mode h6, body.light-mode label {
                color: #212529 !important;
            }

            body.light-mode .form-control, body.light-mode .form-select {
                background-color: #ffffff !important;
                border: 1px solid #ced4da !important;
                color: #212529 !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SporBeslenme</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="KasGruplari" asp-action="Index">Kas Grupları</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Egzersizler" asp-action="Index">Egzersizler</a></li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="icerikDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Okuma Köşesi
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="icerikDropdown">
                                <li><a class="dropdown-item" asp-controller="Makaleler" asp-action="Index">Makaleler</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Haberler"><i class="bi bi-globe"></i> Haberler</a></li>
                                <li><a class="dropdown-item" asp-controller="Tarifler" asp-action="Index">Diyet ve Tarifler</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning" href="#" id="hesapDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-calculator"></i> Araçlar
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="hesapDropdown">
                                <li><a class="dropdown-item text-warning fw-bold" asp-controller="Home" asp-action="VkiHesapla">VKİ Hesapla</a></li>
                                <li><a class="dropdown-item text-success fw-bold" asp-controller="Home" asp-action="KaloriHesapla">Kalori İhtiyacı</a></li>
                            </ul>
                        </li>

                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="AntrenmanProgramlari" asp-action="Index">Programlar</a></li>
                        <li class="nav-item"><a class="nav-link text-info fw-bold" asp-controller="Home" asp-action="SanaOzel">✨ Sana Özel</a></li>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-area="" asp-controller="Account" asp-action="GuvenlikIzleme">
                                    <i class="bi bi-shield-lock"></i> Ağ Radarı
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex ms-auto align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated == true)
                        {
                            // Yüklenmiş fotoğraf var mı diye veritabanına bakıyoruz
                            var user = await UserManager.GetUserAsync(User);
                            string avatarUrl = "https://ui-avatars.com/api/?name=" + User.Identity.Name + "&background=0dcaf0&color=fff&rounded=true&bold=true";

                            if (user != null)
                            {
                                var profil = DbContext.KullaniciDetaylari.FirstOrDefault(x => x.UserId == user.Id);
                                if (profil != null && !string.IsNullOrEmpty(profil.ProfilFotoUrl))
                                {
                                    avatarUrl = profil.ProfilFotoUrl; // Varsa gerçek fotoğrafı çek
                                }
                            }

                            <a asp-controller="Account" asp-action="Bilgilerim" class="text-decoration-none" title="Profilim">
                                <img src="@avatarUrl" alt="Profil" class="rounded-circle" style="width: 40px; height: 40px; border: 2px solid #0dcaf0;" />
                            </a>
                            <a asp-controller="Account" asp-action="Cikis" class="btn btn-outline-danger btn-sm fw-bold">Çıkış Yap</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Giris" class="btn btn-outline-info rounded-pill px-4 fw-bold">Giriş Yap</a>
                            <a asp-controller="Account" asp-action="Kayit" class="btn btn-info text-dark rounded-pill px-4 fw-bold">Kayıt Ol</a>
                        }
                        <div class="d-flex align-items-center ms-3 me-3 text-success border border-success rounded-pill px-3 py-1 bg-dark shadow-sm">
                            <span class="spinner-grow spinner-grow-sm me-2 text-success" role="status" aria-hidden="true"></span>
                            <span class="fw-bold fs-6">Aktif Sporcu: <span id="onlineKullaniciSayaci">0</span></span>
                        </div>

                       
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

   

    <div id="canliBildirimKutusu" class="toast align-items-center text-bg-info border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: none;">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6 text-dark" id="bildirimMesaji">
            </div>
            <button type="button" class="btn-close btn-close-dark me-2 m-auto" onclick="document.getElementById('canliBildirimKutusu').style.display='none'"></button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // 1 Tek ve Merkezi Bağlantı Açıyoruz
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        // 1. DİNLEYİCİ: Sunucudan kullanıcı sayısı geldiğinde
        connection.on("KullaniciSayisiGuncelle", function (sayi) {

            // A. Navbar'daki küçük sayacı güncelle
            var navbarSayaci = document.getElementById("onlineKullaniciSayaci");
            if (navbarSayaci) { navbarSayaci.innerText = sayi; }

            // B. EĞER Komuta Merkezi sayfasındaysak, oradaki devasa sayacı da güncelle!
            var adminSayaci = document.getElementById("onlineKisiSayisi");
            if (adminSayaci) { adminSayaci.innerText = sayi; }
        });

        // 2. DİNLEYİCİ: Sunucudan anlık mesaj (bildirim) geldiğinde
        connection.on("YeniBildirimAl", function (mesaj) {
            document.getElementById("bildirimMesaji").innerText = "🔥 " + mesaj;
            var kutu = document.getElementById("canliBildirimKutusu");
            kutu.style.display = "block";

            // 5 saniye sonra bildirimi otomatik gizle
            setTimeout(function () {
                kutu.style.display = "none";
            }, 5000);
        });

        // Bağlantıyı başlat
        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>