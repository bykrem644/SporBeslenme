@model SporBeslenmeWeb.Models.Tarifler

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4" style="background: #1e2229; border: 1px solid #0dcaf0;">
                <div class="card-header border-info text-center py-4 bg-transparent">
                    <h4 class="text-info fw-bold mb-0">✏️ Tarifi Düzenle</h4>
                </div>
                <div class="card-body p-5 text-light">

                    <form asp-action="Duzenle" method="post">
                        <input type="hidden" asp-for="TarifID" />

                        <div class="mb-4">
                            <label class="form-label text-info fw-bold">Tarif Adı</label>
                            <input type="text" asp-for="Ad" class="form-control bg-dark text-light border-secondary" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-info fw-bold">Kategori</label>
                            <input type="text" asp-for="TarifKategorisi" class="form-control bg-dark text-light border-secondary" required>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4 mb-2">
                                <label class="form-label text-info fw-bold">Karb. (%)</label>
                                <input type="number" asp-for="KarbonhidratYuzdesi" class="form-control bg-dark text-light border-secondary text-center" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label text-info fw-bold">Protein (%)</label>
                                <input type="number" asp-for="ProteinYuzdesi" class="form-control bg-dark text-light border-secondary text-center" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label text-info fw-bold">Yağ (%)</label>
                                <input type="number" asp-for="YagYuzdesi" class="form-control bg-dark text-light border-secondary text-center" required>
                            </div>
                        </div>

                        <div class="p-4 mb-4 rounded-3 border border-warning" style="background: rgba(255, 193, 7, 0.05);">
                            <h6 class="text-warning fw-bold mb-3"><i class="bi bi-robot"></i> Algoritma Filtreleri</h6>

                            <div class="mb-3">
                                <label class="form-label text-light small fw-bold">Alerjen Etiketleri</label>
                                <input type="text" asp-for="IcerdigiAlerjenler" class="form-control bg-dark text-light border-warning" placeholder="Örn: Gluten, Laktoz">
                            </div>

                            <div>
                                <label class="form-label text-light small fw-bold">Ana Malzemeler</label>
                                <input type="text" asp-for="AnaMalzemeler" class="form-control bg-dark text-light border-warning" placeholder="Örn: Tavuk, Yulaf">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-info fw-bold">Malzemeler</label>
                            <textarea asp-for="Malzemeler" rows="3" class="form-control bg-dark text-light border-secondary" required></textarea>
                        </div>

                        <div class="mb-5">
                            <label class="form-label text-info fw-bold">Hazırlanış</label>
                            <textarea asp-for="Hazirlanis" rows="5" class="form-control bg-dark text-light border-secondary" required></textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-warning w-50 fw-bold text-dark py-2">Değişiklikleri Kaydet</button>
                            <a href="/Tarifler/Index" class="btn btn-outline-secondary w-50 fw-bold py-2">İptal Et</a>
                        </div>
                    </form>
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            </div>
        </div>
    </div>
</div>